# SmartEgg local deployment. Copy to .env before running docker compose.
POSTGRES_DB=smartegg
POSTGRES_USER=smartegg
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

NODE_ID=SE-01
SERIAL_PORT=
SERIAL_BAUD=9600
SIMULATE_TELEMETRY=false
SIMULATION_INTERVAL=2
# Solo para pruebas sin Arduino: asocia la telemetría simulada a un lote existente.
SIMULATION_LOT_ID=

MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smartegg-backend-se01
GRAFANA_MQTT_CLIENT_ID=grafana-smartegg

API_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
NEXT_PUBLIC_P5_DASHBOARD_URL=/visualizacion_p5.html
FRONTEND_PORT=3001

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
