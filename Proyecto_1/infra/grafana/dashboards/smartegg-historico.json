      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartegg-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT r.\"timestamp\" AS \"time\", GREATEST(0, 3 - r.espacios_libres) AS \"Huevos ocupados\", r.espacios_libres AS \"Espacios libres\" FROM lecturas AS r WHERE $__timeFilter(r.\"timestamp\") AND r.nodo_id = '${node_id}' ORDER BY r.\"timestamp\";",
          "refId": "A"
        }
      ],
      "title": "Ocupación de la bandeja",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "smartegg-postgres"
      },
      "description": "Resumen térmico y de humedad agrupado por código de lote.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "mode": "gradient",
              "type": "gauge",
              "valueDisplayMode": "text"
