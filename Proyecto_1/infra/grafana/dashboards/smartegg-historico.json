      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartegg-postgres"
          },
          "format": "table",
          "rawSql": "SELECT a.tipo AS \"Tipo\", a.severidad AS \"Severidad\", a.mensaje AS \"Mensaje\", a.inicio_at AS \"Inicio\", a.resolucion_at AS \"Resolucion\", ROUND(EXTRACT(EPOCH FROM (COALESCE(a.resolucion_at, NOW()) - a.inicio_at)) / 60.0, 2) AS \"Duracion (min)\" FROM alarmas AS a WHERE a.nodo_id = '${node_id}' AND a.inicio_at <= $__timeTo() AND COALESCE(a.resolucion_at, NOW()) >= $__timeFrom() ORDER BY a.inicio_at DESC;",
          "refId": "A"
        }
      ],
      "title": "Duración de alarmas críticas",
      "type": "table"
    },
