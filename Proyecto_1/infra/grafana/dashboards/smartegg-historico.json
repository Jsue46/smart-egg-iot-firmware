        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartegg-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT r.\"timestamp\" AS \"time\", r.temperatura AS \"Temperatura (°C)\", r.humedad AS \"Humedad (%)\" FROM lecturas AS r WHERE $__timeFilter(r.\"timestamp\") AND r.nodo_id = '${node_id}' ORDER BY r.\"timestamp\";",
          "refId": "A"
        }
      ],
      "title": "Tendencia de temperatura y humedad",
      "type": "timeseries"
    },
