      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": true,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true
      },
      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "smartegg-postgres"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(l.codigo, 'SIN_LOTE') AS \"Lote\", ROUND(MIN(r.temperatura)::numeric, 2) AS \"Minimo (°C)\", ROUND(MAX(r.temperatura)::numeric, 2) AS \"Maximo (°C)\", ROUND(AVG(r.temperatura)::numeric, 2) AS \"Promedio (°C)\", ROUND(MIN(r.humedad)::numeric, 2) AS \"Humedad minima (%)\", ROUND(MAX(r.humedad)::numeric, 2) AS \"Humedad maxima (%)\", ROUND(AVG(r.humedad)::numeric, 2) AS \"Humedad promedio (%)\" FROM lecturas AS r LEFT JOIN lotes AS l ON l.id = r.lote_id WHERE r.nodo_id = '${node_id}' AND $__timeFilter(r.\"timestamp\") GROUP BY COALESCE(l.codigo, 'SIN_LOTE') ORDER BY \"Lote\";",
          "refId": "A"
        }
      ],
      "title": "Mínimos, máximos y promedios por lote",
      "type": "table"
    },
